{
  "schemaVersion": 1,
  "id": "denemeanticheat-fabric-intermediary",
  "version": "${version}",
  "name": "deneme anticheat",
  "description": "deneme anticheat - server side anticheat for Fabric.",
  "authors": [
    "deneme anticheat"
  ],
  "license": "GPL-3.0",
  "environment": "server",
  "entrypoints": {
    "main": [
      "ac.deneme.anticheat.platform.fabric.DenemeACFabricIntermediaryEntryPoint"
    ],
    "preLaunch": [
      "ac.deneme.anticheat.platform.fabric.DenemeACFabricIntermediaryEntryPoint"
    ]
  },
  "mixins": [
    "denemeanticheat.mixins.json"
  ],
  "accessWidener": "denemeanticheat.accesswidener",
  "custom": {
    "loom:injected_interfaces": {
      "net/minecraft/world/level/Level": [
        "ac/deneme/anticheat/platform/api/world/PlatformWorld"
      ],
      "net/minecraft/world/entity/Entity": [
        "ac/deneme/anticheat/platform/fabric/inject/FabricEntityHandle"
      ],
      "net/minecraft/server/level/ServerPlayer": [
        "ac/deneme/anticheat/platform/fabric/inject/FabricServerPlayerHandle"
      ],
      "net/minecraft/server/MinecraftServer": [
        "ac/deneme/anticheat/platform/fabric/inject/FabricMinecraftServerHandle"
      ],
      "net/minecraft/commands/CommandSourceStack": [
        "ac/deneme/anticheat/platform/api/sender/Sender"
      ]
    }
  },
  "depends": {
    "minecraft": "\u003e\u003d1.16.1 \u003c\u003d1.21.11",
    "java": "\u003e\u003d17",
    "fabricloader": "\u003e\u003d0.16",
    "fabric-lifecycle-events-v1": "*",
    "packetevents": "*"
  },
  "recommends": {
    "cloud": "*",
    "fabric-permissions-api-v0": "*",
    "luckperms": "*"
  }
}
